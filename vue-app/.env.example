GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
JWT_SECRET=generate-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-secret-not-committed
VITE_ADMIN_PANEL_PATH=/control-your-private-admin-path
# Comma-separated addresses as seen by this server; forwarded headers are not trusted.
ADMIN_ALLOWED_IPS=
PORT=3001
NODE_ENV=development
SENTRY_DSN=
DB_BACKUP_INTERVAL_MS=86400000
DB_BACKUP_RETENTION=14
HUIDU_SERVER_URL=https://jsgame.live
HUIDU_AGENCY_UID=replace-with-agency-uid
HUIDU_AES_KEY=replace-with-32-byte-aes-key
HUIDU_PLAYER_PREFIX=replace
GAME_CURRENCY_IN=INR
GAME_CURRENCY_PK=PKR
GAME_CURRENCY_NP=NPR

# Configure the real payment destinations shown to users for manual deposits.
MANUAL_PAYMENT_BANK_NAME=Your bank name
MANUAL_PAYMENT_ACCOUNT_NAME=Account holder name
MANUAL_PAYMENT_ACCOUNT_NUMBER=
MANUAL_PAYMENT_IBAN=
MANUAL_PAYMENT_UPI_ID=
MANUAL_PAYMENT_WALLET_NAME=eSewa or Easypaisa
MANUAL_PAYMENT_WALLET_NUMBER=
MANUAL_PAYMENT_INSTRUCTIONS=Transfer the exact amount, then submit your transaction reference and payment receipt.
