# Create .env.local for local development.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
VITE_ADMIN_PANEL_PATH=/control-your-private-admin-path
# Optional comma-separated IP addresses allowed to access admin login and APIs.
ADMIN_ALLOWED_IPS=
# Configure the real payment destinations shown to users for manual deposits.
MANUAL_PAYMENT_BANK_NAME=Your bank name
MANUAL_PAYMENT_ACCOUNT_NAME=Account holder name
MANUAL_PAYMENT_ACCOUNT_NUMBER=
MANUAL_PAYMENT_IBAN=
MANUAL_PAYMENT_UPI_ID=
MANUAL_PAYMENT_WALLET_NAME=eSewa or Easypaisa
MANUAL_PAYMENT_WALLET_NUMBER=
MANUAL_PAYMENT_INSTRUCTIONS=Transfer the exact amount, then submit your transaction reference and payment receipt.
